# Generated builds, published game sets, assets and benchmark output.
/build/
/games/
/clean/
/shared-assets/
/cases/
/runs/
/evidence/
/baselines/
/state/
/fixture-baseline.json
/suite-role.json

# The local index may contain machine paths. Publish only the sanitized snapshot.
/dashboard/data.js
/dashboard/preview-*

# Downloaded runtime bundles and toolchains. Keep SDK headers, dependency
# manifests and standalone license files elsewhere in vendor/ tracked.
/vendor/fullbench/angle/
/vendor/fullbench/dgvoodoo/
/vendor/fullbench/dxvk/
/vendor/dos/djgpp/
/vendor/dos/dosbox/
/vendor/dos/cwsdpmi/

# DOS runtime assets and generated capture/result files.
/dos/assets/
/dos/CAPTURE.*
/dos/FPS.CSV
/dos/RESULT.*

# Binary releases, compiled output and downloaded archives (any directory).
*.[eE][xX][eE]
*.[dD][lL][lL]
*.addon32
*.addon64
*.[oO][bB][jJ]
*.[pP][dD][bB]
*.ilk
*.exp
*.lib
*.a
*.o
*.so
*.dylib
*.[zZ][iI][pP]
*.7z
*.rar
*.tar
*.gz
*.xz
*.bz2
*.sha256

# Artwork, textures and screenshots. Source SVG icons stay tracked.
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[bB][mM][pP]
*.webp
*.gif
*.tga
*.dds
*.hdr
*.exr
*.ktx
*.ktx2

# Local caches and transient editor/build files.
__pycache__/
*.py[cod]
.pytest_cache/
.vs/
*.user
*.suo
*.log
*.tmp

# Local installation records and machine-specific dependency paths.
/baseline.json
/build-dependencies.json
/PHOENIX-INSTALLATION.md

# .NET intermediates and generated runtime metadata.
[Bb]in/
[Oo]bj/
*.cache

# Public, privacy-filtered result snapshot and screenshot attributions.
!/docs/dashboard/images/*.webp
!/docs/dashboard-preview.png
